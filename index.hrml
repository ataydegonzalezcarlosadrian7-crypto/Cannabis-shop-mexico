<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CANNABIS SHOP | Premium High-End</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    
    <!-- Firebase SDK -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInWithCustomToken, signInAnonymously, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, doc, onSnapshot, addDoc, deleteDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        window.fb = { initializeApp, getAuth, signInWithCustomToken, signInAnonymously, onAuthStateChanged, getFirestore, collection, doc, onSnapshot, addDoc, deleteDoc, serverTimestamp };
    </script>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">

    <style type="text/tailwindcss">
        @layer base {
            body { 
                @apply bg-[#050505] text-zinc-100 antialiased; 
                font-family: 'Plus Jakarta Sans', sans-serif; 
            }
            .font-serif { font-family: 'Playfair Display', serif; }
        }
        
        .no-scrollbar::-webkit-scrollbar { display: none; }
        
        .fade-in { animation: fadeIn 0.8s ease-out forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }

        .loader {
            border-top-color: #10b981;
            animation: spinner 0.8s linear infinite;
        }
        @keyframes spinner { to { transform: rotate(360deg); } }

        .btn-emerald {
            @apply bg-emerald-600 text-white px-8 py-4 text-[11px] uppercase font-black tracking-[0.3em] transition-all hover:bg-emerald-500 hover:shadow-[0_0_30px_rgba(16,185,129,0.3)] disabled:opacity-20;
        }

        .glass-card {
            @apply bg-zinc-900/40 backdrop-blur-xl border border-zinc-800/50 hover:border-emerald-500/50 transition-all duration-500;
        }

        .input-premium {
            @apply bg-zinc-900/50 border border-zinc-800 p-4 text-white outline-none focus:border-emerald-500 transition-all rounded-lg;
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useMemo } = React;

        const firebaseConfig = JSON.parse(__firebase_config);
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'cannabis-shop-v2';
        const initialToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;

        const ADMIN_PIN = "2024";
        const CATEGORIES = ["Todos", "Semillas de cannabis", "Indica", "Sativa", "Híbrida", "Comestibles", "Extractos"];
        const WHATSAPP_NUM = "5215648515663";
        const PAYPAL_USER = "ventas_cannabis"; 
        const SHIPPING_COST = 150; 

        function App() {
            const [view, setView] = useState('home');
            const [user, setUser] = useState(null);
            const [db, setDb] = useState(null);
            const [products, setProducts] = useState([]);
            const [cart, setCart] = useState([]);
            const [loading, setLoading] = useState(true);
            const [isAdmin, setIsAdmin] = useState(false);
            const [activeCategory, setActiveCategory] = useState('Todos');
            const [notification, setNotification] = useState(null);
            const [showAdminModal, setShowAdminModal] = useState(false);
            const [isProcessing, setIsProcessing] = useState(false);
            const [includeShipping, setIncludeShipping] = useState(false);
            
            // Forms
            const [pinInput, setPinInput] = useState('');
            const [newProduct, setNewProduct] = useState({ name: '', price: '', category: 'Semillas de cannabis', image: '', description: '' });

            useEffect(() => {
                const init = async () => {
                    const { initializeApp, getAuth, signInWithCustomToken, signInAnonymously, onAuthStateChanged, getFirestore } = window.fb;
                    const app = initializeApp(firebaseConfig);
                    const auth = getAuth(app);
                    const firestore = getFirestore(app);
                    setDb(firestore);

                    try {
                        if (initialToken) await signInWithCustomToken(auth, initialToken);
                        else await signInAnonymously(auth);
                    } catch (e) { console.error(e); }

                    onAuthStateChanged(auth, (u) => {
                        setUser(u);
                        if (sessionStorage.getItem('cannaAdmin') === 'true') setIsAdmin(true);
                    });
                };

                const waitFB = setInterval(() => {
                    if (window.fb) { clearInterval(waitFB); init(); }
                }, 100);
            }, []);

            useEffect(() => {
                if (!user || !db) return;
                const { collection, onSnapshot } = window.fb;
                const ref = collection(db, 'artifacts', appId, 'public', 'data', 'products');
                
                const unsub = onSnapshot(ref, (snap) => {
                    setProducts(snap.docs.map(d => ({ id: d.id, ...d.data() })));
                    setLoading(false);
                }, () => setLoading(false));

                return () => unsub();
            }, [user, db]);

            const notify = (msg) => {
                setNotification(msg);
                setTimeout(() => setNotification(null), 3000);
            };

            const handleAdminLogin = (e) => {
                e.preventDefault();
                if (pinInput === ADMIN_PIN) {
                    setIsAdmin(true);
                    sessionStorage.setItem('cannaAdmin', 'true');
                    setView('admin');
                    setPinInput('');
                } else {
                    notify("PIN incorrecto");
                }
            };

            const handleImage = (e) => {
                const file = e.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = (ev) => {
                    const img = new Image();
                    img.src = ev.target.result;
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        const MAX_W = 800;
                        const scale = MAX_W / img.width;
                        canvas.width = MAX_W;
                        canvas.height = img.height * scale;
                        canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
                        setNewProduct({...newProduct, image: canvas.toDataURL('image/jpeg', 0.8)});
                    };
                };
                reader.readAsDataURL(file);
            };

            const saveProduct = async (e) => {
                e.preventDefault();
                if (isProcessing || !newProduct.image) return;
                setIsProcessing(true);
                try {
                    const { collection, addDoc, serverTimestamp } = window.fb;
                    await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'products'), {
                        ...newProduct, price: Number(newProduct.price), createdAt: serverTimestamp()
                    });
                    setNewProduct({ name: '', price: '', category: 'Semillas de cannabis', image: '', description: '' });
                    setShowAdminModal(false);
                    notify("Producto en línea");
                } catch (err) { notify("Error al guardar"); }
                finally { setIsProcessing(false); }
            };

            const subtotal = useMemo(() => cart.reduce((a, b) => a + b.price, 0), [cart]);
            const total = useMemo(() => subtotal + (includeShipping ? SHIPPING_COST : 0), [subtotal, includeShipping]);

            const filtered = useMemo(() => 
                activeCategory === 'Todos' ? products : products.filter(p => p.category === activeCategory)
            , [products, activeCategory]);

            if (loading) return (
                <div className="h-screen flex flex-col items-center justify-center gap-6 bg-[#020202]">
                    <div className="w-16 h-16 border-t-4 border-emerald-500 loader rounded-full"></div>
                    <p className="text-[10px] uppercase tracking-[0.6em] font-black text-emerald-500/50">Cargando Dispensario</p>
                </div>
            );

            return (
                <div className="min-h-screen">
                    {/* Header Premium */}
                    <nav className="fixed top-0 w-full z-50 bg-black/60 backdrop-blur-2xl px-8 h-24 flex justify-between items-center border-b border-white/5">
                        <div className="flex items-center gap-10">
                            <button onClick={() => isAdmin ? setView('admin') : setView('login')} className="opacity-10 hover:opacity-100 transition-opacity p-2">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" strokeWidth="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                            </button>
                            <h1 onClick={() => setView('home')} className="font-serif text-3xl font-bold tracking-tighter cursor-pointer text-white italic">CANNABIS<span className="text-emerald-500">SHOP</span></h1>
                        </div>
                        
                        <div className="flex items-center gap-8">
                            <button onClick={() => setView('shop')} className="text-[10px] uppercase font-black tracking-widest hidden md:block text-zinc-400 hover:text-emerald-500 transition-colors">Catálogo</button>
                            <button onClick={() => setView('cart')} className="relative group bg-emerald-500/10 p-3 rounded-full border border-emerald-500/20 transition-all hover:bg-emerald-500/20">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#10b981" strokeWidth="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                                {cart.length > 0 && (
                                    <span className="absolute -top-1 -right-1 bg-white text-emerald-600 text-[9px] w-5 h-5 rounded-full flex items-center justify-center font-black shadow-xl">{cart.length}</span>
                                )}
                            </button>
                        </div>
                    </nav>

                    <main className="pt-24">
                        {view === 'home' && (
                            <section className="relative h-[92vh] flex flex-col items-center justify-center text-center px-6 overflow-hidden">
                                <div className="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-emerald-900/10 via-transparent to-transparent"></div>
                                <div className="relative z-10 space-y-10 fade-in max-w-5xl">
                                    <div className="inline-block px-4 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/5 mb-4">
                                        <span className="text-[9px] uppercase tracking-[0.4em] font-black text-emerald-400">Pureza Garantizada • Envíos a todo el país</span>
                                    </div>
                                    <h2 className="text-8xl md:text-[11rem] font-serif italic font-bold tracking-tighter leading-[0.8] text-white">THE HIGH <br/> <span className="text-emerald-500 underline decoration-zinc-800 underline-offset-8">SOCIETY</span></h2>
                                    <p className="font-serif italic text-xl md:text-3xl text-zinc-500 max-w-3xl mx-auto">Selección ultra-premium de cepas legendarias y derivados orgánicos.</p>
                                    <div className="flex flex-col md:flex-row gap-6 justify-center items-center">
                                        <button onClick={() => setView('shop')} className="btn-emerald px-16 py-6 shadow-2xl">Explorar Menú</button>
                                        <button onClick={() => window.open(`https://wa.me/${WHATSAPP_NUM}`, '_blank')} className="text-[10px] uppercase font-black tracking-widest text-zinc-400 hover:text-white border-b border-zinc-800 pb-1">Soporte Directo</button>
                                    </div>
                                </div>
                            </section>
                        )}

                        {view === 'shop' && (
                            <div className="max-w-7xl mx-auto px-6 py-20">
                                <header className="mb-24 flex flex-col md:flex-row justify-between items-end gap-10">
                                    <div className="space-y-4">
                                        <h2 className="text-6xl font-serif italic tracking-tighter text-white">Dispensario</h2>
                                        <p className="text-emerald-500 font-bold uppercase text-[10px] tracking-[0.3em]">Variedades Exclusivas</p>
                                    </div>
                                    <div className="flex gap-4 overflow-x-auto pb-4 no-scrollbar max-w-full">
                                        {CATEGORIES.map(c => (
                                            <button key={c} onClick={() => setActiveCategory(c)} className={`text-[10px] uppercase font-black tracking-[0.2em] px-8 py-3 rounded-xl transition-all whitespace-nowrap border ${activeCategory === c ? 'bg-emerald-600 text-white border-emerald-500 shadow-[0_0_20px_rgba(16,185,129,0.2)]' : 'bg-zinc-900/50 text-zinc-500 border-zinc-800 hover:text-emerald-400 hover:border-emerald-900'}`}>
                                                {c}
                                            </button>
                                        ))}
                                    </div>
                                </header>
                                
                                <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-10">
                                    {filtered.length > 0 ? filtered.map(p => (
                                        <div key={p.id} className="fade-in group">
                                            <div className="aspect-[4/5] bg-zinc-900/40 rounded-3xl mb-8 overflow-hidden relative cursor-pointer border border-white/5 group-hover:border-emerald-500/50 transition-all duration-700" onClick={() => { setCart([...cart, p]); notify(`${p.name} en carrito`); }}>
                                                <img src={p.image} className="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-110 transition-all duration-1000" alt={p.name} />
                                                <div className="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-60"></div>
                                                <div className="absolute bottom-6 left-6 right-6">
                                                    <button className="w-full bg-white text-black py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest opacity-0 group-hover:opacity-100 translate-y-4 group-hover:translate-y-0 transition-all duration-500 shadow-2xl">Añadir</button>
                                                </div>
                                            </div>
                                            <div className="space-y-3 px-2">
                                                <div className="flex justify-between items-start">
                                                    <h4 className="font-serif text-3xl italic font-bold text-white tracking-tight leading-none">{p.name}</h4>
                                                    <span className="text-xl font-black text-emerald-500 tracking-tighter">${p.price}</span>
                                                </div>
                                                <div className="flex items-center gap-3">
                                                    <span className="px-3 py-1 bg-zinc-900 border border-zinc-800 rounded text-[9px] font-black text-zinc-500 uppercase tracking-widest">{p.category}</span>
                                                </div>
                                            </div>
                                        </div>
                                    )) : (
                                        <div className="col-span-full py-40 text-center opacity-20 border-2 border-dashed border-zinc-900 rounded-[3rem]">
                                            <p className="font-serif italic text-3xl tracking-widest">Esperando nueva cosecha...</p>
                                        </div>
                                    )}
                                </div>
                            </div>
                        )}

                        {view === 'cart' && (
                            <div className="max-w-4xl mx-auto px-6 py-24 fade-in">
                                <h2 className="text-7xl font-serif italic mb-20 tracking-tighter text-center text-white">Tu <span className="text-emerald-500">Pedido</span></h2>
                                {cart.length === 0 ? (
                                    <div className="text-center py-32 glass-card rounded-[3rem] space-y-10 border-dashed border-zinc-700">
                                        <p className="italic font-serif text-4xl text-zinc-600">Aún no hay piezas elegidas.</p>
                                        <button onClick={() => setView('shop')} className="btn-emerald">Ver Menú</button>
                                    </div>
                                ) : (
                                    <div className="grid grid-cols-1 lg:grid-cols-3 gap-16">
                                        <div className="lg:col-span-2 space-y-8">
                                            {cart.map((item, idx) => (
                                                <div key={idx} className="glass-card p-6 rounded-3xl flex gap-8 items-center group">
                                                    <img src={item.image} className="w-28 h-28 object-cover rounded-2xl shadow-2xl" />
                                                    <div className="flex-grow">
                                                        <div className="flex justify-between items-start mb-2">
                                                            <h4 className="font-serif text-3xl italic font-bold text-white tracking-tighter">{item.name}</h4>
                                                            <button onClick={() => setCart(cart.filter((_, i) => i !== idx))} className="text-zinc-600 hover:text-red-500 transition-colors">
                                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                                            </button>
                                                        </div>
                                                        <p className="text-emerald-500 text-[10px] font-black uppercase tracking-widest mb-3">{item.category}</p>
                                                        <p className="text-2xl font-black text-white tracking-tighter">${item.price}</p>
                                                    </div>
                                                </div>
                                            ))}
                                        </div>

                                        <div className="space-y-8">
                                            <div className="glass-card p-8 rounded-[2rem] space-y-8">
                                                <h3 className="text-xl font-bold text-white tracking-tight border-b border-zinc-800 pb-4">Checkout</h3>
                                                
                                                <div className="flex items-center justify-between p-4 bg-zinc-950 rounded-2xl border border-zinc-800 cursor-pointer hover:border-emerald-500 transition-colors" onClick={() => setIncludeShipping(!includeShipping)}>
                                                    <div className="flex items-center gap-4">
                                                        <div className={`w-5 h-5 rounded border-2 flex items-center justify-center transition-all ${includeShipping ? 'bg-emerald-500 border-emerald-500' : 'border-zinc-700'}`}>
                                                            {includeShipping && <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" strokeWidth="4"><path d="M20 6L9 17l-5-5"/></svg>}
                                                        </div>
                                                        <span className="text-[11px] font-black uppercase tracking-widest">Añadir Envío</span>
                                                    </div>
                                                    <span className="font-bold text-emerald-500">${SHIPPING_COST}</span>
                                                </div>

                                                <div className="space-y-4 pt-4">
                                                    <div className="flex justify-between text-zinc-500 text-xs font-bold uppercase tracking-widest">
                                                        <span>Subtotal</span>
                                                        <span>${subtotal}</span>
                                                    </div>
                                                    {includeShipping && (
                                                        <div className="flex justify-between text-zinc-500 text-xs font-bold uppercase tracking-widest">
                                                            <span>Envío</span>
                                                            <span>${SHIPPING_COST}</span>
                                                        </div>
                                                    )}
                                                    <div className="flex justify-between items-end border-t border-zinc-800 pt-6">
                                                        <span className="text-xs font-black uppercase tracking-widest text-emerald-500">Total</span>
                                                        <span className="text-5xl font-serif italic font-bold text-white tracking-tighter">${total}</span>
                                                    </div>
                                                </div>

                                                <div className="space-y-3 pt-4">
                                                    <button onClick={() => window.open(`https://paypal.me/${PAYPAL_USER}/${total}`, '_blank')} className="w-full bg-white text-black py-5 rounded-2xl text-[10px] font-black uppercase tracking-widest flex items-center justify-center gap-3 hover:bg-zinc-200 transition-all">
                                                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M7 2L2 14.5h3.5l1.5-3.5h5.5c3.5 0 6.5-1.5 6.5-5.5s-3-5.5-6.5-5.5H7zm1.5 3h4.5c1.5 0 2.5.5 2.5 2.5s-1 2.5-2.5 2.5H9l-1.5 5h-1.5L8.5 5z"/></svg>
                                                        Pagar con PayPal
                                                    </button>
                                                    <button onClick={() => {
                                                        const text = `¡Hola CANNABIS SHOP! Confirmación de pedido:\n${cart.map(i => `- ${i.name} ($${i.price})`).join('\n')}\n${includeShipping ? '+ Envío ($150)\n' : ''}Total Final: $${total}`;
                                                        window.open(`https://wa.me/${WHATSAPP_NUM}?text=${encodeURIComponent(text)}`, '_blank');
                                                    }} className="w-full bg-emerald-600/10 text-emerald-500 py-5 rounded-2xl text-[10px] font-black uppercase tracking-widest border border-emerald-500/20 hover:bg-emerald-600/20 transition-all">
                                                        Confirmar WhatsApp
                                                    </button>
                                                </div>
                                            </div>
                                            <p className="text-[9px] text-zinc-600 uppercase tracking-widest text-center">Garantía de Entrega Discreta • 100% Seguro</p>
                                        </div>
                                    </div>
                                )}
                            </div>
                        )}

                        {view === 'login' && (
                            <div className="max-w-xs mx-auto py-48 px-6 text-center space-y-12">
                                <div className="space-y-4">
                                    <div className="w-24 h-24 bg-emerald-500/5 rounded-full flex items-center justify-center mx-auto mb-10 border border-emerald-500/10 shadow-[0_0_60px_rgba(16,185,129,0.05)]">
                                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#10b981" strokeWidth="1"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                    </div>
                                    <h3 className="font-serif text-5xl italic tracking-tighter text-white">Staff Only</h3>
                                    <p className="text-[10px] uppercase font-black tracking-widest text-zinc-500 italic">Security clearance required</p>
                                </div>
                                <form onSubmit={handleAdminLogin} className="space-y-6">
                                    <input 
                                        type="password" 
                                        className="w-full bg-transparent border-b-4 border-zinc-900 py-8 text-center text-6xl font-serif tracking-[0.5em] outline-none focus:border-emerald-500 transition-all text-emerald-500"
                                        placeholder="••••"
                                        value={pinInput}
                                        onChange={e => setPinInput(e.target.value)}
                                        autoFocus
                                    />
                                    <button className="btn-emerald w-full mt-10">Acceder</button>
                                </form>
                            </div>
                        )}

                        {view === 'admin' && isAdmin && (
                            <div className="max-w-7xl mx-auto px-6 py-24 fade-in">
                                <header className="flex flex-col md:flex-row justify-between items-end mb-20 gap-10 border-b border-zinc-900 pb-16">
                                    <div className="space-y-4">
                                        <p className="text-emerald-500 font-black uppercase text-[10px] tracking-[0.4em]">Operations Center</p>
                                        <h2 className="text-7xl font-serif italic font-bold tracking-tighter text-white">Stock Control</h2>
                                    </div>
                                    <div className="flex gap-6">
                                        <button onClick={() => { setIsAdmin(false); setView('home'); sessionStorage.removeItem('cannaAdmin'); }} className="px-8 py-4 text-[10px] uppercase font-black tracking-widest text-zinc-600 hover:text-white transition-all">Logout</button>
                                        <button onClick={() => setShowAdminModal(true)} className="btn-emerald rounded-2xl">Nueva Cepa</button>
                                    </div>
                                </header>
                                
                                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                                    {products.map(p => (
                                        <div key={p.id} className="glass-card p-6 flex gap-8 rounded-[2rem]">
                                            <img src={p.image} className="w-28 h-28 object-cover rounded-2xl" />
                                            <div className="flex-grow flex flex-col justify-between py-2">
                                                <div>
                                                    <h4 className="font-serif text-3xl italic font-bold text-white tracking-tighter leading-none">{p.name}</h4>
                                                    <div className="flex gap-2 mt-2 items-center">
                                                        <span className="text-[10px] font-black text-emerald-500 uppercase tracking-widest">${p.price}</span>
                                                        <span className="w-1 h-1 bg-zinc-800 rounded-full"></span>
                                                        <span className="text-[9px] font-bold text-zinc-500 uppercase tracking-widest">{p.category}</span>
                                                    </div>
                                                </div>
                                                <button onClick={async () => {
                                                    if(confirm("¿Eliminar?")) {
                                                        const { doc, deleteDoc } = window.fb;
                                                        await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'products', p.id));
                                                        notify("Eliminado");
                                                    }
                                                }} className="text-[10px] uppercase font-black text-red-500/40 hover:text-red-500 transition-all text-left">Quitar del Menú</button>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}
                    </main>

                    {/* Admin Modal */}
                    {showAdminModal && (
                        <div className="fixed inset-0 z-[100] bg-[#020202] flex flex-col p-8 overflow-y-auto animate-fade-in">
                            <div className="max-w-3xl mx-auto w-full py-16">
                                <div className="flex justify-between items-center mb-24">
                                    <h2 className="font-serif text-6xl italic font-bold tracking-tighter text-emerald-500">Añadir Variedad</h2>
                                    <button onClick={() => setShowAdminModal(false)} className="text-6xl font-light text-zinc-800 hover:text-white transition-transform hover:rotate-90 duration-500">&times;</button>
                                </div>
                                
                                <form onSubmit={saveProduct} className="space-y-16">
                                    <div 
                                        className="aspect-video bg-zinc-900/50 border-2 border-dashed border-zinc-800 rounded-[3rem] flex flex-col items-center justify-center cursor-pointer overflow-hidden transition-all hover:bg-zinc-900 hover:border-emerald-500 group"
                                        onClick={() => document.getElementById('fileIn').click()}
                                    >
                                        {newProduct.image ? (
                                            <img src={newProduct.image} className="w-full h-full object-cover" />
                                        ) : (
                                            <div className="text-center opacity-20 space-y-6 group-hover:opacity-100 transition-opacity">
                                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#10b981" strokeWidth="1.5" className="mx-auto"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                                                <p className="text-[10px] uppercase font-black tracking-[0.4em] text-emerald-500">Fotografía del Producto</p>
                                            </div>
                                        )}
                                    </div>
                                    <input id="fileIn" type="file" className="hidden" accept="image/*" onChange={handleImage} />

                                    <div className="grid grid-cols-1 md:grid-cols-2 gap-12">
                                        <div className="space-y-4">
                                            <label className="text-[10px] uppercase font-black text-zinc-600 tracking-[0.3em] px-1">Cepa / Producto</label>
                                            <input className="input-premium w-full text-2xl font-serif italic bg-transparent border-b-2 rounded-none border-x-0 border-t-0 p-0" placeholder="Lemon Haze..." value={newProduct.name} onChange={e => setNewProduct({...newProduct, name: e.target.value})} required />
                                        </div>
                                        <div className="space-y-4">
                                            <label className="text-[10px] uppercase font-black text-zinc-600 tracking-[0.3em] px-1">Precio Unitario</label>
                                            <input type="number" className="input-premium w-full text-2xl font-black bg-transparent border-b-2 rounded-none border-x-0 border-t-0 p-0 text-emerald-500" placeholder="0.00" value={newProduct.price} onChange={e => setNewProduct({...newProduct, price: e.target.value})} required />
                                        </div>
                                        <div className="space-y-4 md:col-span-2">
                                            <label className="text-[10px] uppercase font-black text-zinc-600 tracking-[0.3em] px-1">Clasificación</label>
                                            <select className="input-premium w-full uppercase font-black text-[11px] tracking-widest cursor-pointer" value={newProduct.category} onChange={e => setNewProduct({...newProduct, category: e.target.value})}>
                                                {CATEGORIES.slice(1).map(c => <option key={c} value={c} className="bg-[#020202]">{c}</option>)}
                                            </select>
                                        </div>
                                    </div>

                                    <button disabled={isProcessing || !newProduct.image} className="btn-emerald w-full py-8 text-[12px] rounded-[2rem]">
                                        {isProcessing ? 'Sincronizando...' : 'Publicar Cosecha'}
                                    </button>
                                </form>
                            </div>
                        </div>
                    )}

                    {/* Notification Toast */}
                    {notification && (
                        <div className="fixed bottom-12 left-1/2 -translate-x-1/2 bg-white text-black px-12 py-5 text-[10px] font-black uppercase tracking-[0.4em] z-[200] shadow-[0_20px_80px_rgba(0,0,0,0.8)] rounded-full fade-in">
                            {notification}
                        </div>
                    )}

                    <footer className="py-32 text-center bg-[#020202] border-t border-zinc-900 mt-40">
                         <h2 className="font-serif text-4xl font-bold tracking-[0.1em] text-white italic uppercase">CANNABIS<span className="text-emerald-500">SHOP</span></h2>
                         <p className="text-[10px] uppercase tracking-[0.8em] text-zinc-700 mt-6 font-black">Private • Professional • Pure</p>
                    </footer>
                </div>
            );
        }

            const root = ReactDOM.createRoot(document.getElementById('root'));
            root.render(<App />);
    </script>
</body>
</html>
